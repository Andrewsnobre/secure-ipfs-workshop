PORT=3333
IPFS_UPLOAD_URL=https://api.ipfs.com.br/upload
IPFS_AUTH_KEY=

# Comma-separated list of origins allowed to call this backend (CORS).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Max upload size in bytes (default 10 MB).
MAX_UPLOAD_BYTES=10485760

# Requests per minute per IP (default 30).
RATE_LIMIT_MAX=30

# Optional shared token: if set, clients must send it as the x-upload-token
# header. Leave empty to keep the proxy open (local workshop use only).
UPLOAD_ACCESS_TOKEN=
